TODOIST_API_TOKEN="your todoist API token here"

GOOGLE_CREDENTIALS_PATH="path to google_credentials.json"
GOOGLE_TOKEN_PATH="path to google_token.json (File will be autogenerated in the specified path)"

GCAL_ID_TASKS="calendar regarding tasks (if you have todoist integration in google calendar)"
GCAL_ID_WORK="workshifts calendar"
GCAL_ID_TIMEMANAGE="calendar specifically to block calendar slots in which you don't want Daian to schedule events"
GCAL_ID_PERSONALEVENTS="main personal events calendar"

DEF_TZ="Your default timezone here e.g.: Europe/Madrid"
